# CSFloat
# Fuer lokale Entwicklung einen gueltigen API-Key eintragen.
# Kann auch ueber die Settings-UI gesetzt werden (verschluesselt uebertragen).
CSFLOAT_API_KEY="replace-with-csfloat-api-key"

# Verschluesselung fuer API-Key Uebertragung (mindestens 32 Zeichen)
# WICHTIG: Dieser Key muss identisch sein zwischen Frontend (build-time) und Backend
ENCRYPTION_KEY="change-this-to-a-32-char-secret-key!!"

# Debug / Observability
DEBUG=false
OBSERVABILITY_ENABLED=true
OBSERVABILITY_EVENTS_API_ENABLED=false
OBSERVABILITY_FRONTEND_TELEMETRY_ENABLED=true
OBSERVABILITY_RETENTION_DAYS=30

# Security (Server)
# Erlaubte CORS-Origin(s), komma-separiert, z.B.:
# CORS_ALLOWED_ORIGINS=https://cs2.clustercontrol.cc,https://app.example.com
CORS_ALLOWED_ORIGINS=
# In Produktion auf true setzen, damit nur konfigurierte Origins + (optional) same-host erlaubt sind.
CORS_STRICT_MODE=true
CORS_ALLOW_SAME_HOST=true
CORS_ALLOW_LOCALHOST=false

# Authentifizierung
# Deny-by-default Auth-Gate: alle /api/v1-Routen ausser der oeffentlichen Allowlist
# (Steam-Login/Callback, session/validate, push/public-key, exchange-rate, cs-updates)
# brauchen eine gueltige Session. Solange false, wird nur geloggt was geblockt WUERDE
# (Event security.auth.request_denied) - erst nach Sichtung auf true stellen.
AUTH_REQUIRED_ENFORCED=false

# Session-Revocation: ausgestellte Tokens tragen eine `jti` und stehen in
# `user_sessions`; Logout/"ueberall abmelden" widerruft dort. Tokens von VOR dieser
# Aenderung haben keine jti und koennen nicht geprueft werden - solange true werden
# sie noch akzeptiert. Nach 30 Tagen (Token-Lebensdauer) sind sie ausgelaufen,
# dann auf false stellen und der Revocation-Check gilt lueckenlos.
SESSION_LEGACY_TOKENS_ALLOWED=true

# Nur aktivieren, wenn der Origin ausschliesslich ueber einen vertrauenswuerdigen
# Proxy (Cloudflare Tunnel) erreichbar ist. Ist der Origin direkt erreichbar, sind
# CF-Connecting-IP/X-Forwarded-For faelschbar und jeder erfundene Wert ergaebe ein
# frisches Rate-Limit-Budget.
TRUST_PROXY_HEADERS=true

# HTTP Rate Limits
# Zwei Stufen: "edge" laeuft vor der DB-Verbindung und limitiert pro IP,
# "session" laeuft nach der Token-Pruefung und limitiert pro Session.
# Mit 0 kann ein einzelnes Limit deaktiviert werden.
SECURITY_RATE_LIMIT_ENABLED=true
# Pepper fuer die Bucket-Hashes. Verlaesst den Server nie; verhindert nur, dass
# man aus Store-Datei/Logs per Rainbow-Table auf SteamIDs/IPs zurueckrechnet.
RATE_LIMIT_PEPPER=
# Stufe "edge" (pro IP)
RATE_LIMIT_GLOBAL_IP_PER_MINUTE=600
RATE_LIMIT_AUTH_LOGIN_PER_MINUTE=20
RATE_LIMIT_AUTH_CALLBACK_PER_MINUTE=40
RATE_LIMIT_AUTH_VALIDATE_PER_MINUTE=240
# Stufe "session" (pro Session)
RATE_LIMIT_DEFAULT_PER_MINUTE=600
RATE_LIMIT_SYNC_PUSH_PER_MINUTE=60
RATE_LIMIT_SYNC_PULL_PER_MINUTE=180
RATE_LIMIT_AUTH_INVENTORY_PER_MINUTE=60
RATE_LIMIT_PUSH_SUBSCRIBE_PER_MINUTE=30
RATE_LIMIT_PUSH_UNSUBSCRIBE_PER_MINUTE=30
# Routen mit externem Fan-out (CSFloat/Steam Market) - bewusst niedrig.
RATE_LIMIT_PRICE_REFRESH_PER_MINUTE=6
RATE_LIMIT_WATCHLIST_SEARCH_PER_MINUTE=60
RATE_LIMIT_CSFLOAT_SYNC_PER_MINUTE=6
RATE_LIMIT_CSFLOAT_EXECUTE_PER_MINUTE=4
# Schreibende Routen
RATE_LIMIT_WATCHLIST_WRITE_PER_MINUTE=60
RATE_LIMIT_WATCHLIST_BATCH_PER_MINUTE=20
RATE_LIMIT_SETTINGS_WRITE_PER_MINUTE=60
RATE_LIMIT_INVESTMENT_WRITE_PER_MINUTE=120
RATE_LIMIT_TELEMETRY_PER_MINUTE=60

# Datenbank (docker-compose + Backend)
DB_HOST=db
DB_NAME=portfolio
DB_USER=portfolio
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root
DB_CHARSET=utf8

# Desktop PHP-Sidecar: wenn DB_HOST fuer Docker "db" ist, nutzt Electron lokal automatisch 127.0.0.1.
# Optional explizit setzen, falls deine lokale DB anders erreichbar ist.
# DESKTOP_DB_HOST=127.0.0.1

# Frontend API-Basis (optional)
# Default im Frontend ist: ${window.location.origin}/api/index.php
# VITE_API_BASE_URL="http://localhost:8080/api/index.php"

# CS Updates Realtime (WebSocket)
# false = nur REST Polling (empfohlen, wenn kein separater WS-Gateway deployed ist)
# true  = versucht Realtime via /ws/updates
VITE_CS_UPDATES_WS_ENABLED=false

# CS Updates Banner Sichtbarkeit (Stunden seit letztem Update, danach ausblenden)
# Default: 168 (7 Tage), Min: 1, Max: 720 (30 Tage)
CS_UPDATES_BANNER_DURATION_HOURS=168

# App/CasaOS Konfiguration fuer docker-compose Interpolation
APP_HOST=127.0.0.1
APP_PORT=8080
PMA_PORT=8081

# Web-Container Image (GitHub Container Registry)
WEB_IMAGE=ghcr.io/control-ger/csportfoliotracking-web:latest
WEB_PULL_POLICY=always

# Pfade fuer Docker Bind-Mounts
# Linux/CasaOS Beispiel:
PROJECT_ROOT_PATH=/path/to/CsPortfolioTracking

